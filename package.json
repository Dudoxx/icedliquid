{
  "name": "icedliquid",
  "version": "0.1.0",
  "private": true,
  "description": "icedLiquid: an in-browser WebGPU voice assistant built on Liquid AI LFM3-Omni.",
  "license": "Apache-2.0",
  "author": "Dudoxx UG <walid@acceleate.com>",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-ort-assets.mjs",
    "prebuild": "node scripts/copy-ort-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3400",
    "build": "next build",
    "start": "next start --port 3400",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "models:provision": "node scripts/provision-models.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/jinja": "^0.5.11",
    "@huggingface/tokenizers": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
