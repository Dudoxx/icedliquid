# icedLiquid server environment. Copy to .env.local and fill only what you need.
# Every key is optional and server-only; none is sent to the browser.
# An empty key turns its tool off: the agent answers "tool_unavailable", never a made-up result.

# WeatherAPI.com key (https://www.weatherapi.com/signup.aspx). Without it get_weather is off, and get_time works only for a time zone, not a place.
WEATHER_API_KEY=
# WeatherAPI base URL. Empty = https://api.weatherapi.com/v1
WEATHER_API_BASE_URL=

# Exa search key (https://dashboard.exa.ai). Without it web_search is off.
EXA_API_KEY=
# Exa base URL. Empty = https://api.exa.ai
EXA_BASE_URL=

# OpenRouter key (https://openrouter.ai/keys). Without it generate_image is off.
OPENROUTER_API_KEY=
# OpenRouter base URL. Empty = https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Folder of the ONNX weights from pnpm models:provision. Empty = models/webgpu-onnx in this repo.
MODELS_DIR=

# Extra host names the tools route accepts, comma separated (for example voice.example.com).
# localhost, 127.0.0.1 and [::1] are always allowed, on any port. Empty = loopback only.
ALLOWED_HOSTS=
