# © Dudoxx UG / Acceleate Consulting - Walid Boudabbous <walid@acceleate.com>
# icedLiquid server environment. Copy to .env.local and fill only what you need.
# Every key is optional and server-only; none is sent to the browser.
# Without a paid key the app still runs in one shot: each tool answers in a visible demo mode
# (a Demo badge on the card, and the agent says so). A key that is set but fails is a loud error,
# never a silent demo. How tools work: docs/TOOLS.md.

# WeatherAPI.com key (https://www.weatherapi.com/signup.aspx). Optional — without it the tool runs in demo mode:
# get_weather uses the free Open-Meteo forecast, and get_time finds a place's zone with the Open-Meteo geocoder.
WEATHER_API_KEY=
# WeatherAPI base URL. Empty = https://api.weatherapi.com/v1
WEATHER_API_BASE_URL=

# Exa search key (https://dashboard.exa.ai). Optional — without it the tool runs in demo mode:
# web_search searches the bundled knowledge/*.md files (Dudoxx, Acceleate, Liquid AI, LFM3, icedLiquid).
EXA_API_KEY=
# Exa base URL. Empty = https://api.exa.ai
EXA_BASE_URL=

# OpenRouter key (https://openrouter.ai/keys). Optional — without it the tool runs in demo mode:
# generate_image shows a bundled sample picture from public/demo/, not a picture of the prompt.
OPENROUTER_API_KEY=
# OpenRouter base URL. Empty = https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Folder of the ONNX weights from pnpm models:provision. Empty = models/webgpu-onnx in this repo.
MODELS_DIR=

# Extra host names the tools route accepts, comma separated (for example voice.example.com).
# localhost, 127.0.0.1 and [::1] are always allowed, on any port. Empty = loopback only.
ALLOWED_HOSTS=
