{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "clsx", "cva", "tw"]
  },
  "ignorePatterns": [
    ".next/",
    "node_modules/",
    "pnpm-lock.yaml",
    "public/",
    "*.md",
    "messages/",
    "src/styles/brands/",
    "src/styles/brand-tokens.ts"
  ]
}
